# Copy to .env. Never commit .env. Local defaults need no service accounts.
PORT=4180
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4180
DATA_DIR=./data
PYTHON_PATH=python
# Production refuses HTTP, an absent encryption key or an unisolated parser.
NODE_ENV=development
# Local server starts and supervises its import worker. Production uses a dedicated worker.
IMPORT_WORKER_AUTOSTART=true
TOKEN_ENCRYPTION_KEY=
PARSER_SANDBOXED=false
# Optional: production worker executable wrapper (must isolate network/CPU/memory).
PARSER_RUNNER=
OPENAI_API_KEY=
AI_MODEL_LIGHT=gpt-4.1-mini
AI_MODEL_REASONING=gpt-4.1
AI_GLOBAL_DAILY_CALLS=100
AI_JOB_CALL_LIMIT=12
AI_MONTHLY_CALL_LIMIT=200
# Calls include retries; budgets fail closed. Configure a provider project spend limit too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDERS_ENABLED=false
# Folder access requires drive.readonly restricted-scope verification before release.
MAIL_API_KEY=
MAIL_FROM=
# Optional Stripe adapter: use only with an eligible merchant account; otherwise replace adapter.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SOLO_PRICE_ID=
STRIPE_PRO_PRICE_ID=
PUBLIC_BASE_DOMAIN=
ACUMIN_STYLESHEET_URL=

STRIPE_SOLO_ANNUAL_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
